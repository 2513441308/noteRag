# ==========================================================
# RAG Agent 环境变量模板
# 复制为 .env 后按需修改；注释行展示的是代码内置默认值。
# 唯一权威清单：src/agent/config.py 的 Config 类。
# ==========================================================

# ============================
# LLM 大模型
# ============================
# 服务商：deepseek（默认）/ openai / qwen（openai/qwen 走兼容协议）
DEFAULT_LLM_PROVIDER=deepseek
# 模型名：deepseek-chat / deepseek-reasoner / qwen-turbo ...
DEFAULT_LLM_MODEL=deepseek-chat
# API Key（必填，在服务商控制台获取，切勿提交到 Git）
DEFAULT_LLM_API_KEY=sk-your-api-key-here
# 采样温度，RAG 场景建议 0
DEFAULT_LLM_TEMPERATURE=0
# 自定义 OpenAI 兼容网关地址：仅 openai/qwen 等兼容协议生效；
# 留空时 deepseek/qwen 自动用内置官方端点，deepseek 官方忽略此项
# DEFAULT_LLM_BASE_URL=https://your-gateway/v1

# ============================
# Embedding 嵌入模型
# ============================
# 提供方：bge（本地 BGE-M3，默认）/ dashscope / openai
EMBEDDING_PROVIDER=bge
# bge 填本地模型目录；云端填 API 模型名（如 text-embedding-3-small）
EMBEDDING_MODEL=/path/to/bge-m3
# 云端 provider 的密钥与端点（本地 bge 不需要，可留占位）
EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 BGE 编码批大小（默认 16）：大批量入库提速，内存紧张时调小
EMBEDDING_BATCH_SIZE=16
# 离线运行开关：代码默认置 1（不联网下载模型）；需要联网下载时显式置 0
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ============================
# 文档切分
# ============================
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150
# CODE_MAX_CHARS=3000
# 分隔符列表：逗号分隔，字面 \n 还原为换行，结尾逗号保留空串；也支持 JSON 数组
# SEPARATORS=\n\n,\n, ,

# ============================
# 知识库源文档
# ============================
# 网页「📚 知识库」面板与 ingestion.sync 管理的文档根目录；相对路径按项目根解析
# KNOWLEDGE_DOCS_DIR=docs/knowledge_base

# ============================
# 向量数据库
# ============================
# 提供方：chroma（本地持久化，默认）/ postgres
# VECTORSTORE_PROVIDER=chroma
# VECTORSTORE_PATH=./chroma_db
# VECTORSTORE_COLLECTION_NAME=rag_agent
# provider=postgres 时使用以下连接配置
# VECTORSTORE_POSTGRES_HOST=localhost
# VECTORSTORE_POSTGRES_PORT=5432
# VECTORSTORE_POSTGRES_USER=postgres
# VECTORSTORE_POSTGRES_PASSWORD=postgres
# VECTORSTORE_POSTGRES_DB=postgres

# ============================
# 检索（双路召回：向量 + BM25）
# ============================
# RETRIEVAL_K=3
# BM25_K=5

# ============================
# Rerank 重排
# ============================
# 总开关：false 时召回结果保序直通、截断到 RERANK_TOP_K
# RERANK_ENABLED=true
# 提供方：local（本地模型，默认）/ siliconflow（云端免费档）/ dashscope
# RERANK_PROVIDER=local
# 模型名：硅基流动 BAAI/bge-reranker-v2-m3 与本地同名，切 provider 无需改此项
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 本地推理设备（仅 local 生效）：cpu / cuda
# RERANK_DEVICE=cpu
# RERANK_TOP_K=3
# 绝对分熔断：重排最高分低于此值则判定知识库未命中（留空=关闭，不熔断）
# RERANK_SCORE_THRESHOLD=
# 邻域扩展：命中块前后各补几片同文档兄弟块（0=关闭；仅 Chroma，旧库缺序号自动跳过）
# RERANK_CONTEXT_WINDOW=1
# 云端 API（provider=local 时忽略；BASE_URL 留空按 provider 取默认端点）
# RERANK_API_KEY=sk-your-rerank-key-here
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_TIMEOUT=30
# 云端失败重试次数：仅网络异常/429/5xx 指数退避，0=关闭
# RERANK_MAX_RETRIES=2

# ============================
# 对话历史压缩（最终回答全量携带历史，由本机制统一控制规模）
# ============================
# 触发条件：消息条数 > 触发值 或 估算 token 超阈值，任一满足即压缩
# SUMMARY_TRIGGER_TOKENS=4000
# SUMMARY_TRIGGER_MESSAGES=10
# 触发后旧消息进摘要的比例（0.5=旧的一半压缩，其余原样保留，取值 (0,1)）
# SUMMARY_COMPRESS_RATIO=0.5
# 滚动摘要长度上限：字数与要点条数
# SUMMARY_MAX_CHARS=300
# SUMMARY_MAX_ITEMS=8
# 检索词改写只看近期语境（条数），与最终回答的历史窗口相互独立
# REBUILD_RETRIEVAL_K=6

# ============================
# Checkpointer 会话检查点
# ============================
# 后端：memory（进程内存，默认，重启即失）/ redis / postgres
# 注意：启用 checkpointer 后每次 invoke 必须传
# config={"configurable": {"thread_id": "会话ID"}}
# CHECKPOINTER_BACKEND=memory
# CP_REDIS_URL=redis://localhost:6379/0
# CP_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/langgraph

# ============================
# LangSmith 追踪（可选，框架原生环境变量）
# ============================
# 开关变量名是 LANGSMITH_TRACING（拼写错误的 LANGSMITH_TRACEING 不会生效）
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=RAG-agent
# LANGSMITH_API_KEY=lsv2-...
